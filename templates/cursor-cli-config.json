{
  "permissions": {
    "allow": [
      "Shell(ls)"
    ],
    "deny": []
  },
  "version": 1,
  "editor": {
    "vimMode": false,
    "defaultBehavior": "agent"
  },
  "model": {
    "modelId": "default",
    "displayModelId": "auto",
    "displayName": "Auto",
    "displayNameShort": "Auto",
    "aliases": [
      "auto"
    ],
    "maxMode": false
  },
  "maxMode": false,
  "network": {
    "useHttp1ForAgent": false
  },
  "approvalMode": "allowlist",
  "sandbox": {
    "mode": "disabled",
    "networkAccess": "user_config_with_defaults"
  },
  "attribution": {
    "attributeCommitsToAgent": true,
    "attributePRsToAgent": true
  }
}
