# Claude
.claude/debug/
.claude/backups/
.claude/cache/
.claude/chrome/
.claude/tasks/
.claude/

# Cursor 
.cursor/hooks/state/

# Pi (pi.dev) — secrets and per-machine state
.pi/agent/auth.json
.pi/agent/sessions/
.pi/agent/settings.json

# 1Password CLI — daemon socket and per-machine config
.config/op/op-daemon.sock
.config/op/config

# SwiftPM — Xcode-managed symlinks into ~/Library/Caches, never dotfiles
.config/swiftpm/

# Runtime / cache / machine-specific
.config/.android/
.config/cursor/chats/
.config/cursor/statsig-cache.json
.config/configstore/
.config/cagent/
.config/atuin/atuin-receipt.json
.atuin/bin/
.atuin/logs/

# yarn global installs — reinstalled on demand, not version-controlled state
.config/yarn/global/node_modules/
.config/yarn/global/yarn.lock
# tmux plugins are installed & managed by TPM (XDG default path), not committed
.config/tmux/plugins/
.config/raycast/
.config/raycast-x/

# Google Cloud SDK state — OAuth tokens, credentials, virtualenv, logs
.config/gcloud/

# Homebrew trust store — per-machine state
.config/homebrew/

# 1Password app — per-machine telemetry/state
.config/1Password/

# macOS junk
.DS_Store
